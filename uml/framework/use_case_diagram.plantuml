@startuml
left to right direction
skinparam actorBackgroundColor LightBlue
skinparam usecaseBackgroundColor LightYellow

actor "ML Developer" as Dev

rectangle "Framework Extension Points" {
  usecase "Define DTOs" as UC1
  usecase "Implement Preparator" as UC2
  usecase "Implement Processor" as UC3
  usecase "Implement Interpreter" as UC4
  usecase "Configure Pipeline" as UC5
  usecase "Run Pipeline" as UC6
}

Dev --> UC1 : <<required>>
Dev --> UC2 : <<required>>
Dev --> UC3 : <<required>>
Dev --> UC4 : <<required>>
Dev --> UC5
Dev --> UC6

UC2 ..> UC1 : <<uses>>
UC3 ..> UC1 : <<uses>>
UC5 ..> UC2 : <<includes>>
UC5 ..> UC3 : <<includes>>
UC5 ..> UC4 : <<includes>>
UC6 ..> UC5 : <<precedes>>

note top of UC1
  <b>Обязательное расширение</b>
  Унаследовать ProcessorInput,
  ProcessorOutput
end note

note top of UC2
  <b>Обязательное расширение</b>
  Реализовать интерфейс Preparator
end note
@enduml
